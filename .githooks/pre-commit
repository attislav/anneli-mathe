#!/bin/sh
# Pre-commit hook: validate all skilltree JSON files
# Blocks commit if any skilltree has schema errors

echo "Validating skilltrees..."
node scripts/validate-skilltree.cjs
if [ $? -ne 0 ]; then
  echo "❌ Skilltree validation failed. Fix errors before committing."
  exit 1
fi
echo "✅ Skilltree validation passed."
